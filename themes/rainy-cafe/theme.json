  "shape": { "radius": 22, "density": "roomy", "borderWidth": 1 },
  "ui": { "surface": "paper", "glass": 0.9, "blur": 10, "shadow": "soft", "topbar": "glass", "decor": "stitch",
          "heroStyle": "plain", "overlay": "grain", "cursorLight": false, "hideStageArt": true },
  "icons": { "style": "thin", "color": "muted", "custom": { "settings": "icons/settings.svg" } },
  "loader": { "style": "pulse" },
  "motion": { "fps": 30, "resolution": 0.7, "interactive": true },
  "scene": { "file": "scene.js", "params": { "bokeh": 26, "drops": 90, "sliders": 12 } },
  "welcome": { "file": "welcome.js", "height": 150, "text": "a quiet corner" },
  "textSafety": { "scrim": 0.4, "heroScrim": 0.25, "blur": 6, "busy": "low" }
